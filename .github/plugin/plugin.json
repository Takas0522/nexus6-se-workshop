    "./.github/fabric-skills/skills/spark-consumption-cli",
    "./.github/fabric-skills/skills/spark-authoring-cli",
    "./.github/fabric-skills/skills/eventhouse-consumption-cli",
    "./.github/fabric-skills/skills/eventhouse-authoring-cli",
    "./.github/fabric-skills/skills/eventstream-consumption-cli",
    "./.github/fabric-skills/skills/eventstream-authoring-cli",
    "./.github/fabric-skills/skills/activator-consumption-cli",
    "./.github/fabric-skills/skills/activator-authoring-cli",
