  "agents": [
    "./.github/fabric-skills/agents/FabricAdmin.agent.md",
    "./.github/fabric-skills/agents/FabricDataEngineer.agent.md",
    "./.github/fabric-skills/agents/FabricAppDev.agent.md",
    "./.github/fabric-skills/agents/FabricIQ.agent.md"
  ],
  "mcpServers": {
    "FabricIQ": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/fabricaihub/integrations/m365",
      "headers": {
        "X-VARIANTS": "Fabric.Routing.PowerBIDataExploration"
      }
    },
    "azure": {
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"]
    }
  },
  "hooks": {
    "paths": ["./.github/azure-skills/hooks/copilot-hooks.json"],
    "exclusive": true
  }
