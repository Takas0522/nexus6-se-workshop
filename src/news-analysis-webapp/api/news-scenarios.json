  {
    "id": "3",
    "title": "\u7DCF\u52D9\u7701\u3001\u65E5\u672C\u56FD\u5185\u306E\u5149\u30D5\u30A1\u30A4\u30D0\u30FC\u7DB2\u6574\u5099\u306B\u8FFD\u52A0\u4E88\u7B974,200\u5104\u5186\u3092\u8A08\u4E0A\u2014\u20142028\u5E74\u5EA6\u672B\u307E\u3067\u306B\u5168\u4E16\u5E2F\u30AB\u30D0\u30FC\u738799.9%\u3092\u76EE\u6307\u3059",
    "summary": "\u7DCF\u52D9\u7701\u306F2026\u5E747\u670810\u65E5\u30012026\u5E74\u5EA6\u88DC\u6B63\u4E88\u7B97\u6848\u306B\u304A\u3044\u3066\u56FD\u5185\u5149\u30D5\u30A1\u30A4\u30D0\u30FC\u7DB2\u6574\u5099\u4E8B\u696D\u306B\u8FFD\u52A0\u30674,200\u5104\u5186\u3092\u8A08\u4E0A\u3059\u308B\u65B9\u91DD\u3092\u767A\u8868\u3057\u305F\u3002\u73FE\u5728\u3001\u5168\u56FD\u306E\u5149\u30D5\u30A1\u30A4\u30D0\u30FC\u30AB\u30D0\u30FC\u7387\u306F99.3%\u3060\u304C\u3001\u4E2D\u5C71\u9593\u5730\u57DF\u3084\u96E2\u5CF6\u90E8\u3092\u4E2D\u5FC3\u306B\u7D0452\u4E07\u4E16\u5E2F\u304C\u672A\u6574\u5099\u306E\u307E\u307E\u6B8B\u3055\u308C\u3066\u3044\u308B\u3002\u4ECA\u56DE\u306E\u8FFD\u52A0\u6295\u8CC7\u3067\u306F\u3001NTT\u6771\u65E5\u672C\u30FB\u897F\u65E5\u672C\u3001KDDI\u3001\u30BD\u30D5\u30C8\u30D0\u30F3\u30AF\u306E\u4E3B\u89813\u30B0\u30EB\u30FC\u30D7\u306B\u5BFE\u3057\u3001\u672A\u6574\u5099\u5730\u57DF\u3078\u306E\u6577\u8A2D\u8CBB\u7528\u306E\u6700\u592770%\u3092\u56FD\u304C\u88DC\u52A9\u3059\u308B\u5236\u5EA6\u3092\u65B0\u8A2D\u3002\u677E\u672C\u525B\u660E\u7DCF\u52D9\u5927\u81E3\u306F\u8A18\u8005\u4F1A\u898B\u3067\u300C\u30C7\u30B8\u30BF\u30EB\u7530\u5712\u90FD\u5E02\u56FD\u5BB6\u69CB\u60F3\u306E\u5B9F\u73FE\u306B\u4E0D\u53EF\u6B20\u306A\u30A4\u30F3\u30D5\u30E9\u6574\u5099\u3092\u52A0\u901F\u3059\u308B\u300D\u3068\u8FF0\u3079\u305F\u3002\u3042\u308F\u305B\u3066\u30015G\u57FA\u5730\u5C40\u306E\u5171\u7528\u4FC3\u9032\u30AC\u30A4\u30C9\u30E9\u30A4\u30F3\u3082\u6539\u5B9A\u3055\u308C\u3001\u30ED\u30FC\u30AB\u30EB5G\u4E8B\u696D\u8005\u306E\u53C2\u5165\u969C\u58C1\u7DE9\u548C\u304C\u76DB\u308A\u8FBC\u307E\u308C\u305F\u3002\u696D\u754C\u56E3\u4F53\u306E\u30C6\u30EC\u30B3\u30E0\u30B5\u30FC\u30D3\u30B9\u5354\u4F1A\u306F\u300C\u6295\u8CC7\u56DE\u53CE\u304C\u898B\u8FBC\u307F\u306B\u304F\u3044\u5730\u57DF\u3078\u306E\u516C\u7684\u652F\u63F4\u306F\u6B53\u8FCE\u300D\u3068\u30B3\u30E1\u30F3\u30C8\u3057\u3066\u3044\u308B\u3002",
